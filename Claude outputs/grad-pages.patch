+/* ---------- deadline resolution ---------- */
+function pad(n){ return (n<10?"0":"")+n; }
+function nthWeekday(y, m, wd, n){            /* m 1-12, wd 0=Sun */
+  var d = new Date(y, m-1, 1), add = (wd - d.getDay() + 7) % 7;
+  return new Date(y, m-1, 1 + add + (n-1)*7);
+}
+function nextDate(f, today){
+  var cands = [], y = today.getFullYear(), i, yy;
+  for (yy = y; yy <= y+1; yy++){
+    if (f.md) for (i=0;i<f.md.length;i++){
+      cands.push(new Date(yy, +f.md[i].slice(0,2)-1, +f.md[i].slice(3,5)));
+    }
+    if (f.nth) cands.push(nthWeekday(yy, f.nth.m, f.nth.d, f.nth.n));
+  }
+  cands = cands.filter(function(d){ return d >= today; }).sort(function(a,b){ return a-b; });
+  return cands[0] || null;
+}
+var MON = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
+function fmt(d){ return d.getDate() + " " + MON[d.getMonth()] + " " + d.getFullYear(); }
+
+var today = new Date(); today.setHours(0,0,0,0);
+F.forEach(function(f){
+  f._d = nextDate(f, today);
+  f._days = f._d ? Math.round((f._d - today) / 86400000) : 9999;
+});
+F.sort(function(a,b){ return a._days - b._days; });
+
+/* ---------- render ---------- */
+var CIT = {
+  visa:   {cls:"visa",   txt:"Open to visa holders"},
+  us:     {cls:"usonly", txt:"US citizens / PR only"},
+  watch:  {cls:"nom",    txt:"Citizenship rules vary"},
+  special:{cls:"nom",    txt:"Special eligibility category"}
+};
+var FIELD = {open:"Open-field", disease:"Disease-specific", id:"Infection &amp; immunity",
+             quant:"Computational &amp; physical", intl:"International"};
+
+function esc(s){ return String(s); }
+function card(f, i){
+  var c = CIT[f.cit] || CIT.visa;
+  var dcls = f._days <= 30 ? "hot" : (f._days <= 90 ? "soon" : "");
+  var dtxt = f._d ? fmt(f._d) + " &middot; " + (f._days === 0 ? "today" : f._days + "d") : "rolling";
+  var bar = '<span class="odl ' + dcls + '">' + dtxt + '</span>' +
+            '<span class="' + c.cls + '">' + c.txt + '</span>' +
+            '<span>' + FIELD[f.f] + '</span>' +
+            (f.nom ? '<span class="nom">' + f.nomTxt + '</span>' : '');
+  return '<article class="card prop" data-field="' + f.f + '" data-cit="' + f.cit +
+         '" data-days="' + f._days + '" data-q="' + (f.n + " " + f.s + " " + f.note).toLowerCase().replace(/"/g,"") + '">' +
+    '<div class="phead"><span class="pid">' + pad(i+1) + '</span>' +
+      '<span class="tierbadge">' + f.s + '</span>' +
+      '<h3><a href="' + f.u + '" target="_blank" rel="noopener">' + f.n + '</a></h3></div>' +
+    '<div class="oppbar">' + bar + '</div>' +
+    '<div class="split">' +
+      '<div><h4>Terms</h4><dl class="terms">' +
+        '<dt>Award</dt><dd>' + f.award + '</dd>' +
+        '<dt>Duration</dt><dd>' + f.dur + '</dd>' +
+        '<dt>Cycle</dt><dd>' + f.pat + '</dd>' +
+      '</dl></div>' +
+      '<div><h4>Eligibility</h4><p class="onote" style="margin-top:0">' + f.elig + '</p>' +
+        '<p class="onote"><strong>Citizenship.</strong> ' + f.citTxt + '</p>' +
+        '<p class="onote">' + f.note + '</p></div>' +
+    '</div></article>';
+}
+
+document.getElementById("list").innerHTML = F.map(card).join("");
+document.getElementById("nTotal").textContent = F.length;
+document.getElementById("nVisa").textContent  = F.filter(function(f){ return f.cit === "visa"; }).length;
+document.getElementById("nSoon").textContent  = F.filter(function(f){ return f._days <= 90; }).length;
+document.getElementById("nNom").textContent   = F.filter(function(f){ return f.nom; }).length;
+
+/* ---------- filters ---------- */
+var state = {field:"all", cit:"all", when:"all", q:""};
+function apply(){
+  var cards = document.querySelectorAll("#list .prop"), shown = 0;
+  Array.prototype.forEach.call(cards, function(el){
+    var ok = (state.field === "all" || el.dataset.field === state.field) &&
+             (state.cit === "all" || el.dataset.cit === state.cit) &&
+             (state.when === "all" || +el.dataset.days <= 90) &&
+             (state.q === "" || el.dataset.q.indexOf(state.q) > -1);
+    el.hidden = !ok;
+    if (ok) shown++;
+  });
+  document.getElementById("shown").textContent = shown + " of " + F.length;
+  document.getElementById("empty").hidden = shown > 0;
+}
+Array.prototype.forEach.call(document.querySelectorAll(".fchip"), function(b){
+  b.addEventListener("click", function(){
+    var f = b.dataset.f;
+    Array.prototype.forEach.call(document.querySelectorAll('.fchip[data-f="' + f + '"]'), function(o){
+      o.setAttribute("aria-pressed", o === b ? "true" : "false");
+    });
+    state[f] = b.dataset.v;
+    apply();
+  });
+});
+document.getElementById("q").addEventListener("input", function(e){
+  state.q = e.target.value.toLowerCase().trim();
+  apply();
+});
+apply();
+</script>
+
+</body>
+</html>
