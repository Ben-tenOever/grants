+function pad2(n){ return (n<10?"0":"")+n; }
+function themeCard(t, idx){
+  var ideas = t.ideas.map(function(i){
+    return '<div class="idea">' +
+      '<h5>' + i.t + '</h5>' +
+      '<p>' + i.p + '</p>' +
+      '<p class="why"><strong>Why it works as a training plan.</strong> ' + i.w + '</p>' +
+      '<div class="fmatch">' + i.f.map(function(x){ return '<span>' + x + '</span>'; }).join('') + '</div>' +
+    '</div>';
+  }).join('');
+  var hay = (t.name + " " + t.hereIf + " " + t.caps + " " +
+             t.ideas.map(function(i){ return i.t + " " + i.p + " " + i.f.join(" "); }).join(" "))
+             .toLowerCase().replace(/<[^>]+>/g,"").replace(/"/g,"");
+  return '<article class="card prop" data-cl="' + t.cl + '" data-q="' + hay + '">' +
+    '<div class="phead"><span class="pid">' + pad2(idx+1) + '</span>' +
+      '<span class="tierbadge">' + CL[t.cl] + '</span>' +
+      '<span class="tierbadge">' + t.ideas.length + ' directions</span>' +
+      '<h3>' + t.name + '</h3></div>' +
+    '<p class="here-if"><strong>You are in this space if</strong> ' + t.hereIf + '</p>' +
+    '<p class="caps"><strong>Already running in the department:</strong> ' + t.caps + '</p>' +
+    '<div class="ideas">' + ideas + '</div>' +
+  '</article>';
+}
+var CL = {virus:"Virology &amp; RNA biology", bact:"Bacterial &amp; parasite pathogenesis",
+          immune:"Immunology &amp; vaccines", comp:"Computational &amp; microbiome",
+          struct:"Structural &amp; mechanistic"};
+
+document.getElementById("list").innerHTML = T.map(themeCard).join("");
+
+var state = {cl:"all", q:""};
+function apply(){
+  var cards = document.querySelectorAll("#list .prop"), shown = 0;
+  Array.prototype.forEach.call(cards, function(el){
+    var ok = (state.cl === "all" || el.dataset.cl === state.cl) &&
+             (state.q === "" || el.dataset.q.indexOf(state.q) > -1);
+    el.hidden = !ok;
+    if (ok) shown++;
+  });
+  document.getElementById("shown").textContent = shown + " of " + T.length + " themes";
+  document.getElementById("empty").hidden = shown > 0;
+}
+Array.prototype.forEach.call(document.querySelectorAll(".fchip"), function(b){
+  b.addEventListener("click", function(){
+    var f = b.dataset.f;
+    Array.prototype.forEach.call(document.querySelectorAll('.fchip[data-f="' + f + '"]'), function(o){
+      o.setAttribute("aria-pressed", o === b ? "true" : "false");
+    });
+    state[f] = b.dataset.v;
+    apply();
+  });
+});
+document.getElementById("q").addEventListener("input", function(e){
+  state.q = e.target.value.toLowerCase().trim();
+  apply();
+});
+apply();
+</script>
+
+</body>
+</html>
